# Solo NOMBRES y valores de ejemplo locales. El portal no usa base de datos.
PORT=3002
# URL del ESB (base o con /esb/v1). En Vercel: https://<proyecto-servicios>.vercel.app
ESB_URL=http://127.0.0.1:8080/esb/v1
CONSUMIDOR=CON02
# API key de demo del consumidor registrada en el ESB (viaja al navegador: no es un secreto)
API_KEY=con02-demo-key
USUARIO=usuario.distribuidor
