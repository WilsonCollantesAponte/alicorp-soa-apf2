# Proyecto 3 – Servicios SOA + ESB. Copiar a .env (NO se versiona) o definir en Vercel.
# Solo nombres de variables: los valores reales nunca van al repositorio.

# Cadena de conexión de Postgres (Neon). Si no existe, se usa SQLite local en data/alicorp_soa.db
DATABASE_URL=

# --- Opcionales ---
# Ruta del archivo SQLite cuando no hay DATABASE_URL
SOA_DB_PATH=
# http (local, procesos separados) | inproc (app unificada / Vercel; app_unificada.py lo fija solo)
SOA_TRANSPORTE=
# URL de los servicios para el transporte http (por defecto http://127.0.0.1:8000/api/v1)
SOA_BASE_URL=
# Destino del ESB en modo http (reemplaza destino_servicios de esb-config/routes.yaml)
ESB_DESTINO=
# Reemplazan las API keys de demo de routes.yaml (deben coincidir con API_KEY de cada portal)
ESB_API_KEY_CON01=
ESB_API_KEY_CON02=
# Archivo de trazas del ESB (en Vercel se usa /tmp/mediaciones.jsonl)
ESB_LOG_PATH=
# Solo pruebas desde redes que bloquean el puerto 5432: neon_http
SOA_DB_DRIVER=
